// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Merchant {
  id                String   @id @default(cuid())
  email             String   @unique
  name              String?
  stripeAccountId   String?  @unique
  stripeAccessToken String? // OAuth access token for the connected account (encrypt at rest in production)
  apiKey            String   @unique @default(cuid()) // used to authenticate incoming access-event webhooks
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  disputes     Dispute[]
  accessEvents AccessEvent[]
}

enum DisputeStatus {
  NEEDS_EVIDENCE
  DRAFTING
  READY_TO_SUBMIT
  SUBMITTED
  WON
  LOST
}

model Dispute {
  id                String        @id @default(cuid())
  merchantId        String
  merchant          Merchant      @relation(fields: [merchantId], references: [id])
  stripeDisputeId   String        @unique
  stripeChargeId    String
  reason            String // Stripe dispute reason code, e.g. "product_not_received"
  amount            Int // smallest currency unit
  currency          String
  status            DisputeStatus @default(NEEDS_EVIDENCE)
  evidenceDueBy     DateTime?
  customerEmail     String?
  customerIp        String?
  receiptUrl        String?
  billingDetails    Json?
  narrative         String? // LLM-drafted evidence narrative, human-reviewed before submit
  narrativeApproved Boolean       @default(false)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  accessEvents AccessEvent[]

  @@index([merchantId, status])
}

// Proof-of-delivery events merchants report (login, download, usage) used as dispute evidence.
model AccessEvent {
  id            String   @id @default(cuid())
  merchantId    String
  merchant      Merchant @relation(fields: [merchantId], references: [id])
  disputeId     String?
  dispute       Dispute? @relation(fields: [disputeId], references: [id])
  customerEmail String
  eventType     String // e.g. "login", "download", "api_usage"
  occurredAt    DateTime
  metadata      Json?
  createdAt     DateTime @default(now())

  @@index([merchantId, customerEmail])
  @@index([disputeId])
}
