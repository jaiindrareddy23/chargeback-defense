# Postgres connection string. For local dev: `docker compose up -d`, then
# postgresql://dispute_shield:dispute_shield@localhost:5432/dispute_shield
DATABASE_URL=

# Stripe platform keys (from your Stripe Dashboard > Developers > API keys)
STRIPE_SECRET_KEY=

# Stripe Connect: Dashboard > Settings > Connect > Platform settings > Client ID
STRIPE_CONNECT_CLIENT_ID=

# Stripe webhook signing secret. For local dev, run:
#   stripe listen --forward-to localhost:3000/api/webhooks/stripe
# and copy the "whsec_..." secret it prints.
STRIPE_WEBHOOK_SECRET=

# Claude API key (console.anthropic.com) used to draft evidence narratives.
ANTHROPIC_API_KEY=

# Optional: override the model used for narrative drafting.
# ANTHROPIC_MODEL=claude-sonnet-5-5
